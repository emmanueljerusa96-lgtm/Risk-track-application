rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /risk_reports/{uid}/{reportId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid &&
        fileName.matches('photo[.](jpg|png)') &&
        request.resource.size <= 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(jpeg|png)');
      allow update: if false;
      // Permit cleanup only while the report does not exist. Authors cannot
      // remove evidence after a report is published or verified.
      allow delete: if request.auth != null && request.auth.uid == uid &&
        !firestore.exists(/databases/(default)/documents/risk_reports/$(reportId));
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
